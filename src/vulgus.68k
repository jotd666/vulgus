update_e200_objects_20be:               	| ...
	GET_ADDRESS	e200_obj_tbl_e200,a2       	| [$20be: ld      ix,e200_obj_tbl_e200]
	GET_ADDRESS	spriteram_shadow_ef00+0x20,a3	| [$20c2: ld      iy,spriteram_shadow_ef00+0x20] set s8.code as base
	move.b	#9,d1                           	| [$20c6: ld      b,9] 9 objects
	LOAD_HL	spawn_flying_free_slot_threshold_e0ab	| [$20c8: ld      hl,spawn_flying_free_slot_threshold_e0ab]
	MAKE_HL	a0                             	| [$20cb: ld      (hl),0] reset
	clr.b	(a0)                             	| [...] reset

loc_20cd:                               	| ...
	MAKE_HL_NO_AR                          	| [$20cd: push    hl]
	move.w	d6,-(a7)                        	| [...]
	MAKE_BC_NO_AR                          	| [$20ce: push    bc]
	move.w	d2,-(a7)                        	| [...]
	move.b	(0x00,a2),d0                    	| [$20cf: ld      a,(ix+$00)] object state
                                         | [$20d2: and     a] inactive?
	jeq	loc_20e4                           	| [$20d3: jr      z,loc_20e4] yes,skip
	MAKE_HL	a0                             	| [$20d5: inc     (hl)] inc formation free slot threshold
	addq.b	#1,(a0)                         	| [...] inc formation free slot threshold
	 |  [$20d6: ld      hl,loc_20e4] save return address [push_function]
	pea	loc_20e4 |  [$20d9: push    hl]
	addq.b	#1,d0                           	| [$20da: inc     a] active?
	jeq	update_e200_obj_20f3               	| [$20db: jr      z,update_e200_obj_20f3] yes,go
	addq.b	#1,d0                           	| [$20dd: inc     a] $FE?
	jeq	loc_2288                           	| [$20de: jp      z,loc_2288] yes,go
	jra	loc_22ca                           	| [$20e1: jp      loc_22ca]
* ---------------------------------------------------------------------------

loc_20e4:                               	| ...
	move.w	(a7)+,d2                        	| [$20e4: pop     bc]
	MAKE_B                                 	| [...]
	move.w	(a7)+,d6                        	| [$20e5: pop     hl]
